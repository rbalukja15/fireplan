{
  "name": "fireplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "build": "npm run build:web && npm run build:ext",
    "build:web": "tsc -b && vite build --mode web",
    "build:ext": "vite build --mode ext",
    "test": "vitest run",
    "preview": "vite preview --mode web",
    "zip:ext": "node scripts/zip-ext.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
