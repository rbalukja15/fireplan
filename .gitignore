__pycache__/
*.pyc

# Scratch dump of a response that produced no readings. Deliberately NOT
# last_response.html: that name holds the committed capture of the real form
# that every offline test is built on, and pointing the failure dump at it
# meant one bad submission silently replaced the fixture with a stub.
last_failure.html

# results.jsonl is deliberately NOT ignored. It is the measurement record --
# the only durable output of a run, and every request in it cost someone
# else's bandwidth. It belongs in the repo.

# Generated by scripts/bundle.py — derived, never edited by hand.
battle-calculator.html

# Predictions, derived from web/engine.js by scripts/*_predict.mjs. They are
# written BEFORE a sweep is submitted and copied into the meta of every row
# they were made against, so results.jsonl is the durable record and the file
# on disk is scratch. Committing one invites a reader to trust a prediction
# made by an engine that has since changed; the probe refuses to submit
# against a prediction file older than the engine for the same reason.
# fortdrift_pred.json was committed by mistake and is untracked now.
bughunt_pred.json
fortdrift_pred.json
latedrift_pred.json
